# Tic-Tac-Toe Compose Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# NETWORK SELECTION
# ============================================
# Set to true for local Hardhat network, false for Sepolia testnet
LOCAL=true

# ============================================
# LOCAL HARDHAT CONFIGURATION
# ============================================
# Local RPC endpoint (default Hardhat node)
LOCAL_RPC_URL=http://127.0.0.1:8545/

# Hardhat chain ID (default 31337)
HARDHAT_CHAIN_ID=31337

# Private keys for local testing (Hardhat default accounts)
# Account #0: 0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266 (10000 ETH)
PRIVATE_KEY_HARDHAT_0=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Account #1: 0x70997970C51812dc3A010C7d01b50e0d17dc79C8 (10000 ETH)
PRIVATE_KEY_HARDHAT_1=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d

# Path to your tic-tac-toe-smart-contract project
# Used for running deployment scripts
HARDHAT_PROJECT_DIR=/Users/yourusername/tic-tac-toe-smart-contract

# ============================================
# SEPOLIA TESTNET CONFIGURATION
# ============================================
# Alchemy API key for Sepolia testnet
# Get your API key from: https://www.alchemy.com/
ALCHEMY_API_KEY=your_alchemy_api_key_here

# Sepolia RPC URL (uses Alchemy)
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Sepolia chain ID (11155111)
SEPOLIA_CHAIN_ID=11155111

# Private keys for Sepolia testnet (YOUR KEYS - NEVER COMMIT THESE!)
# Get test ETH from: https://cloud.google.com/application/web3/faucet/ethereum/sepolia
PRIVATE_KEY_PLAYER1=your_private_key_for_player_1
PRIVATE_KEY_PLAYER2=your_private_key_for_player_2

# ============================================
# OPTIONAL CONFIGURATION
# ============================================
# Custom path to npx executable (if not in PATH)
# NPX_PATH=/usr/local/bin/npx
